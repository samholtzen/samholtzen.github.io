---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Writing">
  <h1>Writing</h1>
  {posts.length === 0 && <p class="muted">Nothing here yet.</p>}
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          {post.data.draft && <span class="label"> Draft</span>}
          <time class="muted" datetime={post.data.date.toISOString()}>
            {fmt.format(post.data.date)}
          </time>
          {post.data.description && <p class="muted">{post.data.description}</p>}
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .posts li {
    margin-bottom: 1.75rem;
  }

  .posts a {
    font-size: var(--text-lg);
  }

  time {
    display: block;
    font-size: var(--text-sm);
  }

  .posts p {
    margin: 0.25rem 0 0;
  }
</style>

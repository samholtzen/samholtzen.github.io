---
import type { Publication } from '../lib/bibtex';

interface Props {
  publications: Publication[];
  /** Show a year heading before each new year. */
  groupByYear?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { publications, groupByYear = true, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

// Notebook-style entry numbers: oldest paper is 1, so existing numbers never
// change when a new paper is added at the top.
const numbers = new Map(publications.map((pub, i) => [pub.key, publications.length - i]));
const width = String(publications.length).length;
const entryNumber = (key: string) => String(numbers.get(key)).padStart(Math.max(width, 2), '0');

const groups: { year: number; items: Publication[] }[] = [];
for (const pub of publications) {
  const last = groups.at(-1);
  if (groupByYear && last?.year === pub.year) last.items.push(pub);
  else if (!groupByYear && last) last.items.push(pub);
  else groups.push({ year: pub.year, items: [pub] });
}
---

{
  groups.map((group) => (
    <section class="pub-group">
      {groupByYear && <Heading class="pub-year">{group.year}</Heading>}
      <ol class="pubs">
        {group.items.map((pub) => (
          <li class="pub" id={pub.key}>
            <span class="pub-num" aria-hidden="true">
              [{entryNumber(pub.key)}]
            </span>
            <span class="pub-title" set:html={pub.titleHtml} />
            <span class="pub-authors">
              {pub.authors.map((a, i) => (
                <>
                  {a.isSelf ? <strong>{a.display}</strong> : a.display}
                  {i < pub.authors.length - 1 ? ', ' : ''}
                </>
              ))}
              {pub.etAl && ', et al.'}
            </span>
            <span class="pub-venue">
              {pub.venue && <em>{pub.venue}</em>}
              {pub.venue && ' '}({pub.year})
              {pub.links.map((l) => (
                <>
                  {' · '}
                  <a href={l.href}>{l.label}</a>
                </>
              ))}
            </span>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .pub-year {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    margin: 2.25rem 0 0.75rem;
    font-variant-numeric: lining-nums;
  }

  .pub-group:first-child .pub-year {
    margin-top: 0;
  }

  .pubs {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pub {
    display: grid;
    grid-template-columns: 3.1rem 1fr;
    column-gap: 0.5rem;
    row-gap: 0.15rem;
    margin-bottom: 1.25rem;
    max-width: calc(var(--measure) + 3.6rem);
  }

  .pub > :not(.pub-num) {
    grid-column: 2;
  }

  /* Notebook entry number, e.g. [07]. */
  .pub-num {
    grid-column: 1;
    grid-row: 1 / span 3;
    font-family: var(--font-label);
    font-size: 0.8rem;
    line-height: 1.9;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .pub-title {
    font-size: var(--text-base);
    line-height: 1.35;
  }

  .pub-authors,
  .pub-venue {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .pub-authors strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
